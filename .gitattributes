# ==============================================================================
# QODE Fleet Unified .gitattributes
# Enforces cross-platform line endings and binary file handling
# ==============================================================================

# Default text normalization to LF
* text=auto eol=lf

# Markdown, documentation & text files
*.md text eol=lf
*.txt text eol=lf
*.adoc text eol=lf
*.rst text eol=lf

# Data & Config formats
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.csv text eol=lf

# Source code
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.go text eol=lf
*.rs text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.exe binary
*.dll binary
*.bin binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
